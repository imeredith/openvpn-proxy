{
  "manifest_version": 3,
  "name": "OpenVPN Site Proxy",
  "version": "1.1.0",
  "description": "Send selected sites through your OpenVPN SOCKS5 proxy.",
  "permissions": [
    "activeTab",
    "storage",
    "proxy",
    "privacy",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenVPN Site Proxy"
  },
  "incognito": "not_allowed",
  "key": ""
}
